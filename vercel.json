{
  "crons": [
    {
      "path": "/api/daily-stats",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/stripe/webhook/:farrierId",
      "destination": "/api/stripe-payment?webhookFarrier=:farrierId"
    },
    {
      "source": "/api/stripe/connect-events",
      "destination": "/api/stripe-payment?connectEvents=1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/pay/:invoiceId",
      "destination": "/api/stripe-payment?payPage=1&invoice=:invoiceId"
    },
    {
      "source": "/mobile",
      "destination": "/mobile.html"
    },
    {
      "source": "/mobile-manifest.json",
      "destination": "/mobile-manifest.json"
    },
    {
      "source": "/mobile-sw.js",
      "destination": "/mobile-sw.js"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/mobile-sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/((?!.*\\.).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(index|mobile).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
